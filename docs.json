{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "mintlify-hydip",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Common",
            "pages": [
              "index"
            ]
          },
          {
            "group": "User management",
            "pages": [
              "user-management/sso"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
      ]
    }
  },
  "logo": {
    "light": "/logo/hydip-logo-white-transparent.svg",
    "dark": "/logo/hydip-logo-white-transparent.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hydip.support@ior.com.au"
      }
    ],
    "primary": {
      "type": "button",
      "label": "HyDip",
      "href": "https://www.hydip.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/ior-fuelling-australia/"
    }
  }
}
